{
    "extends": "stylelint-config-standard",
    "rules": {
      "import-notation": "string",
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": ["mixin", "include", "use", "forward", "function", "return", "if", "else", "each", "for", "while"]
        }
      ]
    }
}
